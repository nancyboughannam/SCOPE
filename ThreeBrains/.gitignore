# IDE / Editor Settings
# ----------------------------
# Eclipse
.settings
.classpath
.project

# IntelliJ IDEA
.idea
*.iml
out
gen

# VS Code
.vscode/

# ----------------------------
# Python Specific
# ----------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Logs / temp files
# NOTE: *.log is scoped to exclude sim_results/ below — EdgeCloudSim's real
# simulation output (the paper's actual result data) is also named *.log
# (e.g. SIMRESULT_..._GENERIC.log), and a blanket *.log rule was silently
# eating all of it. This line only ignores stray logs elsewhere.
*.log
!sim_results/**/*.log
*.tmp
*.bak
